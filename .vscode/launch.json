{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Vitest (arquivo atual)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Vitest (todos os testes)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Depurar arquivo atual",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["--import", "tsx"],
      "args": ["Você é um assistente útil e responda em português.", "bf0bb1a6-d58c-44b6-8ca1-143ec2eca5d0"],
      "envFile": "${workspaceFolder}/.env.local",
      "console": "externalTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}